# korea-data-mcp API keys. Copy to .env and fill in; run with: korea-data-mcp -env-file /abs/path/.env
# Leave a value empty to disable that provider.

# OpenDART (전자공시) — https://opendart.fss.or.kr
OPENDART_API_KEY=

# 공공데이터포털 — https://www.data.go.kr (Decoding 키를 넣으세요)
DATAGOKR_SERVICE_KEY=

# 국가법령정보 공동활용 — https://open.law.go.kr
# 마이페이지 > API인증키관리의 OC 값. 이 컴퓨터의 공인 IP도 그곳에 등록해야 합니다.
# OC는 응답 링크에 그대로 실리므로 다른 키와 같은 값을 쓰지 마세요.
LAWGOKR_OC= 